# Optional commercial deploy overrides for MarkdownExam.
# Copy to .env. Omitted or empty values keep the built-in defaults.
# Do not commit .env.

# Phrase that makes GET /api/index.php return the admin redirect.
# Example: ADMIN_KEYWORD=change-me
ADMIN_KEYWORD=

# Location returned when the phrase matches.
ADMIN_REDIRECT=/admin/index.php
